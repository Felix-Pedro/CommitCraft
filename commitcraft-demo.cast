[0.455, "o", "\u001b[1m                                                                                                                                                       \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1mCommitCraft config [OPTIONS]\u001b[0m\u001b[1m                                                                                                                  \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                                                                                                       \u001b[0m\r\n"]
[0.001, "o", " \u001b[1;36mInteractively creates a configuration file.\u001b[0m                                                                                                           \r\n                                                                                                                                                       \r\n \u001b[2mLaunch an interactive wizard to configure CommitCraft settings including:\u001b[0m                                                                             \r\n \u001b[2m• \u001b[0m\u001b[2;32mProvider settings\u001b[0m\u001b[2m (Ollama, OpenAI, Google, Groq)\u001b[0m                                                                                                    \r\n \u001b[2m• \u001b[0m\u001b[2;33mModel selection\u001b[0m                                                                                                                                     \r\n \u001b[2m• \u001b[0m\u001b[2;35mEmoji conventions\u001b[0m                                                                                                                                   \r\n \u001b[2m• \u001b[0m\u001b[2;34mProject context\u001b[0m                                                                                                                                     \r\n                                                                                                                                                       \r\n \u001b[2mUse \u001b[0m\u001b[1;2;36m-\u001b[0m\u001b[1;2;36m-generate\u001b[0m\u001b[1;2;36m-ignore\u001b[0m\u001b[2m to create a .ignore file with default patterns.\u001b[0m                                                                                 \r\n                                                                                                                                                       \r\n"]
[0.003, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-generate\u001b[0m\u001b[1;36m-ignore\u001b[0m  \u001b[1;32m-i\u001b[0m        Generate a \u001b[36m.commitcraft/.ignore\u001b[0m file with default patterns                                                             \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m                       Show this message and exit.                                                                                            \u001b[2m│\u001b[0m\r\n\u001b[2m╰─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.625, "o", "\r\nThis creates configuration files in .commitcraft/ or ~/.config/commitcraft/\r\n"]
