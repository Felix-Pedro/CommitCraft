[0.676, "o", "\u001b[3m                CommitCraft Dry Run                \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mMetric              \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mValue                   \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│\u001b[36m \u001b[0m\u001b[36mToken Count         \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m1179                    \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mSystem Prompt Tokens\u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m1070                    \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mUser Prompt Tokens  \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m109                     \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mModel               \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32mqwen3                   \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mProvider            \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32mollama                  \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mHost                \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32mhttps://ollama.mydomain/\u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mContext Size        \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m1884                    \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mContext Utilization \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m62.6%                   \u001b[0m\u001b[32m \u001b[0m│\r\n└──────────────────────┴──────────────────────────┘\r\n"]
[1.702, "o", "\u001b[H\u001b[2J━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n4. Multiple Provider Support\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\nCommitCraft supports multiple LLM providers:\r\n  • Ollama (local models)\r\n  • OpenAI (GPT-4, GPT-3.5)\r\n  • Google Gemini\r\n  • Groq\r\n"]
[0.000, "o", "  • Anthropic Claude\r\n  • OpenAI-compatible APIs (DeepSeek, LocalAI, etc.)\r\n"]
[0.000, "o", "\r\nExample usage with different providers:\r\n"]
