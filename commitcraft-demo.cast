[0.429, "o", "\u001b[3m                                                          CommitCraft Environment Variables                                                           \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1;36m \u001b[0m\u001b[1;36mVariable Name               \u001b[0m\u001b[1;36m \u001b[0m┃\u001b[1;36m \u001b[0m\u001b[1;36mDescription                                     \u001b[0m\u001b[1;36m \u001b[0m┃\u001b[1;36m \u001b[0m\u001b[1;36mExample/Notes                                                   \u001b[0m\u001b[1;36m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│\u001b[32m \u001b[0m\u001b[1;33mAPI Keys\u001b[0m\u001b[32m                    \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[1;33mProvider authentication\u001b[0m\u001b[37m                         \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m                                                                \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mOPENAI_API_KEY              \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mAPI key for OpenAI provider                     \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2msk-...                                                          \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mGROQ_API_KEY                \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mAPI key for Groq provider                       \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mgsk_...                                                         \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mGOOGLE_API_KEY              \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mAPI key for Google Gemini provider              \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mAIza...                                                         \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mANTHROPIC_API_KEY           \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mAPI key for Anthropic Claude provider           \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2msk-ant-...                                                      \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mOLLAMA_API_KEY              \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mAPI key for Ollama Cloud or remote instances    \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mOptional for remote Ollama                                      \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCUSTOM_API_KEY              \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mAPI key for openai_compatible provider          \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mRequired for custom endpoints                                   \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mNICKNAME_API_KEY            \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mAPI key for named provider profiles             \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2me.g., REMOTE_API_KEY, DEEPSEEK_API_KEY                          \u001b[0m\u001b[2m \u001b[0m│\r\n├──────────────────────────────┼──────────────────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤\r\n│\u001b[32m \u001b[0m\u001b[1;33mProvider Configuration\u001b[0m\u001b[32m      \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[1;33mProvider-specific settings\u001b[0m\u001b[37m                      \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m                                                                \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mOLLAMA_HOST                 \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mHost URL for Ollama provider                    \u001b[0m\u001b[37"]
[0.000, "o", "m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mhttp://localhost:11434                                          \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_PROVIDER        \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mDefault LLM provider                            \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mollama, openai, groq, google, anthropic                         \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_MODEL           \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mDefault model name                              \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mqwen3, gpt-4, gemini-2.5-flash, etc.                            \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_HOST            \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mAPI host URL (for custom providers)             \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mhttps://api.example.com                                         \u001b[0m\u001b[2m \u001b[0m│\r\n├──────────────────────────────┼──────────────────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤\r\n│\u001b[32m \u001b[0m\u001b[1;33mModel Options\u001b[0m\u001b[32m               \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[1;33mGeneration parameters\u001b[0m\u001b[37m                           \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m                                                                \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_SYSTEM_PROMPT   \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mCustom system prompt for the model              \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mOverride default prompt                                         \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_TEMPERATURE     \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mSampling temperature (creativity)               \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m0.0-2.0 (default varies by provider)                            \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_TOP_P           \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mNucleus sampling threshold                      \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m0.0-1.0                                                         \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_MAX_TOKENS      \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mMaximum tokens to generate                      \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mInteger value                                                   \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_NUM_CTX         \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mContext window size (Ollama)                    \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mInteger value                                                   \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_MIN_CONTEXT_SIZE\u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mMinimum context size for auto-calculation       \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mDefault: 1024                                                   \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_MAX_CONTEXT_SIZE\u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mMaximum context size for auto-calculation       \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mDefault: 128000                                                 \u001b[0m\u001b[2m \u001b[0m│\r\n├──────────────────────────────┼──────────────────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤\r\n│\u001b[32m \u001b[0m\u001b[1;33mBehavior & Features\u001b[0m\u001b[32m         \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[1;33mTool behavior settings\u001b[0m\u001b[37m                          \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m                                                                \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_EMOJI           \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mEmoji mode for commit messages                  \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2msimple, full, no/false, or cust"]
[0.001, "o", "om string                        \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_NO_EMOJI        \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mDisable emoji in commit messages (deprecated)   \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mUse COMMITCRAFT_EMOJI=no instead                                \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_SHOW_THINKING   \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mDisplay model's thinking process if available   \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m1/true to enable, 0/false to disable                            \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_CONFIRM         \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mEnable two-step confirmation mode               \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mShows dry-run before generating                                 \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_CLUE            \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mCustom CommitClue for personalized context      \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2me.g., 'This fixes the login issue' or 'Performance optimization'\u001b[0m\u001b[2m \u001b[0m│\r\n├──────────────────────────────┼──────────────────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤\r\n│\u001b[32m \u001b[0m\u001b[1;33mOutput & Display\u001b[0m\u001b[32m            \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[1;33mTerminal output settings\u001b[0m\u001b[37m                        \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m                                                                \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mNO_COLOR                    \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mDisable colored output (standard)               \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m1 to disable colors                                             \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mFORCE_COLOR                 \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mForce colored output                            \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m1 to force colors (default)                                     \u001b[0m\u001b[2m \u001b[0m│\r\n├──────────────────────────────┼──────────────────────────────────────────────────┼──────────────────────────────────────────────────────────────────┤\r\n│\u001b[32m \u001b[0m\u001b[1;33mGit Hook Settings\u001b[0m\u001b[32m           \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[1;33mHook behavior configuration\u001b[0m\u001b[37m                     \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m                                                                \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_SKIP            \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mSkip CommitCraft hook execution                 \u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2mSet to 1 to skip: COMMITCRAFT_SKIP=1 git commit                 \u001b[0m\u001b[2m \u001b[0m│\r\n│\u001b[32m \u001b[0m\u001b[32mCOMMITCRAFT_CLUE_PROMPT     \u001b[0m\u001b[32m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mOverride hook's interactive mode for CommitClues\u001b[0m\u001b[37m \u001b[0m│\u001b[2m \u001b[0m\u001b[2m1/true=always prompt, 0=never prompt, unset=use hook default    \u001b[0m\u001b[2m \u001b[0m│\r\n└──────────────────────────────┴──────────────────────────────────────────────────┴──────────────────────────────────────────────────────────────────┘\r\n"]
[0.002, "o", "\r\n\u001b[2m💡 Tip: Set these in \u001b[0m\u001b[2;36m.env\u001b[0m\u001b[2m or \u001b[0m\u001b[2;36mCommitCraft.env\u001b[0m\u001b[2m file, or export them in your shell.\u001b[0m\r\n"]
[0.001, "o", "\u001b[2m📖 For more details, see: \u001b[0m\u001b[2;4;36mhttps://felix-pedro.github.io/CommitCraft/\u001b[0m\r\n"]
[0.824, "o", "All variables can be set before the commit command for hook users!\r\n"]
[3.006, "o", "\u001b[H\u001b[2J"]
[0.001, "o", "╔════════════════════════════════════════════════════════════╗\r\n║                                                            ║\r\n"]
