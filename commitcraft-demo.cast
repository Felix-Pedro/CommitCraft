[0.000, "o", "\u001b[38;2;137;180;250mcommit_guidelines\u001b[0m\u001b[38;2;205;214;244m \u001b[0m\u001b[38;2;147;153;178m=\u001b[0m\u001b[38;2;205;214;244m \u001b[0m\u001b[38;2;166;227;161m\"\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Never ask for folow-up questions.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Don't ask quetions.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Don't talk about yourself.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Be concise and clear.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Be informative.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Don't explain row by row just the global goal of the changes.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Avoid unecessary details and long explanations.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Use action verbs.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Use bullet points in the body if there are many changes\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Do not talk about the hashes.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Create concise and comprehensive commit messages.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Be direct about what changed and why. Focous on what.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Give a small summary of what has changed and how it may afect the rest of the project.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Do not return any explanation other then the commit message itself.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - If there are many changes focous on the main ones.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - The first row shall be te title of your message, so make it simple and informative.\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    - Do not introduce your message!\u001b[0m\u001b[38;2;245;194;231m\\n\u001b[0m\u001b[38;2;166;227;161m    \u001b[0m\u001b[38;2;166;227;161m\"\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[38;2;147;153;178m[\u001b[0m\u001b[38;2;148;226;213mmodels\u001b[0m\u001b[38;2;147;153;178m]\u001b[0m\r\n"]
