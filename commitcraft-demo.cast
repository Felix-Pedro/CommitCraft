[2.500, "o", "\u001b[3m       CommitCraft Configuration Preview        \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mMetric              \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mValue                \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│\u001b[36m \u001b[0m\u001b[36mToken Count         \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m1234                 \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mSystem Prompt Tokens\u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m1067                 \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mUser Prompt Tokens  \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m167                  \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mModel               \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32mgemini-2.5-flash-lite\u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mProvider            \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32mgoogle               \u001b[0m\u001b[32m \u001b[0m│\r\n└──────────────────────┴───────────────────────┘\r\n\r\nProceed with commit message generation? [Y/n]: "]
